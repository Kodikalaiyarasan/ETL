# ─────────────────────────────────────────────
# E-Commerce Data Lakehouse — Environment Template
# Copy to .env for local adjustments
# ─────────────────────────────────────────────

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=lakehouse_admin
MINIO_ROOT_PASSWORD=lakehouse_secret_2024
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=lakehouse_admin
MINIO_SECRET_KEY=lakehouse_secret_2024
S3_BUCKET_RAW=ecommerce-raw
S3_BUCKET_CURATED=ecommerce-curated

# PostgreSQL (Redshift stand-in)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce_warehouse
POSTGRES_USER=warehouse_admin
POSTGRES_PASSWORD=warehouse_secret_2024

# Elasticsearch
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=http

# Spark
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_DRIVER_MEMORY=1g
SPARK_EXECUTOR_MEMORY=1g

# Data Generation Volumes
NUM_CUSTOMERS=500
NUM_PRODUCTS=200
NUM_TRANSACTIONS=5000
NUM_REVIEWS=2000
NUM_CLICKSTREAM_EVENTS=10000
GENERATION_SEED=42

